<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Sân Thể Thao</title>
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/demo.css">
  <link rel="stylesheet" href="/assets/css/owner-calendar.css">
</head>
<body class="demo-page owner-calendar-page">
  <a class="owner-calendar-skip" href="#owner-calendar-main">Đến lịch điều hành</a>
  <div class="demo-shell">
    <%- include('partials/navigation') %>
    <main id="owner-calendar-main" class="owner-calendar-main" aria-labelledby="owner-calendar-title" tabindex="-1">
      <a class="owner-calendar-back" href="/owner"><span aria-hidden="true">←</span> Quản lý cơ sở</a>
      <header class="owner-calendar-heading">
        <div class="owner-calendar-heading-copy">
          <p class="owner-calendar-kicker">QUẢN LÝ CƠ SỞ / LỊCH SÂN</p>
          <h1 id="owner-calendar-title">Lịch điều hành sân</h1>
          <p class="owner-calendar-description">Xem lịch từng sân trong cơ sở, theo từng ô 30 phút.</p>
        </div>
        <p class="owner-calendar-count"><strong><%= courtRows.length %></strong><span>sân trong cơ sở</span></p>
      </header>
      <section class="owner-calendar-facility" aria-labelledby="owner-calendar-facility-title">
        <span class="owner-calendar-facility-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none"><rect x="6" y="8" width="28" height="24" rx="2"/><path d="M20 8v24M6 20h28"/><circle cx="20" cy="20" r="6"/></svg>
        </span>
        <div>
          <p class="owner-calendar-facility-label">CƠ SỞ ĐANG QUẢN LÝ</p>
          <h2 id="owner-calendar-facility-title"><%= facility.name %></h2>
          <p><%= facility.address %></p>
        </div>
      </section>
      <section class="owner-calendar-controls" aria-labelledby="owner-calendar-filter-title">
        <h2 id="owner-calendar-filter-title" class="owner-calendar-section-title">Chọn ngày xem lịch</h2>
        <form action="/owner/calendar" method="GET" class="owner-calendar-date-form">
          <div class="owner-calendar-date-field">
            <label for="calendar-date">Ngày xem lịch</label>
            <input type="date" id="calendar-date" name="date" value="<%= selectedDate %>" min="<%= dayOptions[0].date %>" required>
          </div>
          <button type="submit" class="owner-calendar-submit">Xem lịch <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
        <nav class="owner-calendar-days" aria-label="Bảy ngày từ hôm nay">
          <% for (const day of dayOptions) { %>
            <a class="owner-calendar-day" href="/owner/calendar?date=<%= encodeURIComponent(day.date) %>" <% if (day.isSelected) { %>aria-current="date"<% } %>>
              <span class="owner-calendar-day-label"><%= day.label %></span>
              <span class="owner-calendar-day-note"><%= day.isSelected ? 'Đang xem' : day.date === dayOptions[0].date ? 'Hôm nay' : 'Xem lịch' %></span>
            </a>
          <% } %>
        </nav>
      </section>
      <section class="owner-calendar-schedule" aria-labelledby="owner-calendar-schedule-title">
        <div class="owner-calendar-schedule-heading">
          <div>
            <h2 id="owner-calendar-schedule-title" class="owner-calendar-section-title">Lịch ngày <%= formatDate(selectedDate) %></h2>
            <p class="owner-calendar-selected-note">Theo giờ Việt Nam · 30 phút mỗi ô</p>
          </div>
          <span class="owner-calendar-readonly">Chỉ xem lịch</span>
        </div>
        <%
          const calendarStatuses = {
            AVAILABLE: { label: 'Trống', symbol: '○' },
            LOCKED: { label: 'Đang giữ', symbol: '◷' },
            BOOKED: { label: 'Đã đặt', symbol: '✓' },
            UNAVAILABLE: { label: 'Không phục vụ', symbol: '—' }
          };
        %>
        <ul class="owner-calendar-legend" aria-label="Chú giải trạng thái ô giờ">
          <% for (const [status, info] of Object.entries(calendarStatuses)) { %>
            <li><span class="owner-calendar-legend-marker" data-status="<%= status %>" aria-hidden="true"><%= info.symbol %></span><span><%= info.label %></span></li>
          <% } %>
        </ul>
        <% if (!courtRows.length) { %>
          <div class="owner-calendar-empty">
            <svg aria-hidden="true" viewBox="0 0 48 48" fill="none"><rect x="7" y="10" width="34" height="28" rx="3"/><path d="M24 10v28M7 24h34"/><circle cx="24" cy="24" r="7"/></svg>
            <h2>Cơ sở chưa có sân.</h2>
            <p>Lịch điều hành sẽ hiển thị khi cơ sở có sân được cấu hình.</p>
            <a class="owner-calendar-return" href="/owner">Về quản lý cơ sở <span aria-hidden="true">→</span></a>
          </div>
        <% } else if (!timeColumns.length) { %>
          <div class="owner-calendar-empty">
            <svg aria-hidden="true" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="17"/><path d="M24 14v11l7 4"/></svg>
            <h2>Chưa có giờ phục vụ.</h2>
            <p>Chưa có ô giờ để hiển thị trong lịch của cơ sở. Bạn có thể quay về trang quản lý để xem thông tin sân.</p>
            <a class="owner-calendar-return" href="/owner">Về quản lý cơ sở <span aria-hidden="true">→</span></a>
          </div>
        <% } else { %>
          <p id="owner-calendar-help" class="owner-calendar-scroll-hint"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M4 12h16M8 8l-4 4 4 4M16 8l4 4-4 4"/></svg>Cuộn ngang trong bảng để xem thêm giờ. Dùng phím Tab để chọn bảng, sau đó dùng phím mũi tên trái/phải.</p>
          <div class="owner-calendar-scroll" role="region" aria-label="Lịch các sân, cuộn ngang để xem thêm giờ" aria-describedby="owner-calendar-help" tabindex="0">
            <table class="owner-calendar-table">
              <caption class="owner-calendar-sr-only">Lịch sân tại <%= facility.name %>, ngày <%= formatDate(selectedDate) %>, theo giờ Việt Nam</caption>
              <thead><tr>
                <th scope="col" class="owner-calendar-corner">Sân / giờ</th>
                <% for (const column of timeColumns) { %><th scope="col"><%= column.time %>–<%= column.endTime %></th><% } %>
              </tr></thead>
              <tbody>
                <% for (const row of courtRows) { %>
                  <tr data-court-id="<%= row.courtId %>">
                    <th scope="row" class="owner-calendar-court"><span class="owner-calendar-court-name"><%= row.name %></span><% if (!row.active) { %><span class="owner-calendar-inactive">Tạm ngừng</span><% } %></th>
                    <% for (const slot of row.slots) { %>
                      <% const info = calendarStatuses[slot.status] || { label: 'Chưa xác định', symbol: '?' }; %>
                      <td data-time="<%= slot.time %>" data-status="<%= slot.status %>"><span class="owner-calendar-slot"><span class="owner-calendar-slot-symbol" aria-hidden="true"><%= info.symbol %></span><span><%= info.label %></span></span></td>
                    <% } %>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
      <footer class="owner-calendar-footer">
        <p>Lịch phản ánh trạng thái khi tải trang. Chọn ngày và bấm Xem lịch để cập nhật.</p>
        <a href="/owner">Về quản lý cơ sở <span aria-hidden="true">↗</span></a>
      </footer>
    </main>
  </div>
</body>
</html>
