<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Sân Thể Thao</title>
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/demo.css">
</head>
<body class="demo-page">
  <div class="demo-shell">
    <%- include('partials/navigation') %>
    <main class="demo-card demo-narrow">
      <h1><%= title %></h1>
      <p class="demo-muted">Tạo tài khoản của bạn. Đăng ký thành công sẽ chuyển đến trang đăng nhập.</p>
      <% if (errorMessage) { %>
        <p class="demo-error" role="alert"><%= errorMessage %></p>
      <% } %>
      <form action="/register" method="POST" class="demo-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="fullName">Họ tên</label>
        <input type="text" id="fullName" name="fullName" value="<%= fullName %>" autocomplete="name" maxlength="100" required>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= email %>" autocomplete="username" maxlength="254" required>
        <label for="password">Mật khẩu</label>
        <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" aria-describedby="passwordHelp" required>
        <p id="passwordHelp" class="demo-muted">Ít nhất 8 ký tự, không quá 72 byte.</p>
        <label for="confirmPassword">Nhập lại mật khẩu</label>
        <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" minlength="8" required>
        <button type="submit" class="demo-button">Đăng ký</button>
      </form>
      <p>Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
    </main>
  </div>
</body>
</html>
