<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>
<%= title %> | SanXanh</title>
<link rel="stylesheet" href="/assets/css/app.css">
<link rel="stylesheet" href="/assets/css/demo.css">
<link rel="stylesheet" href="/assets/css/design-system.css">
<link rel="stylesheet" href="/assets/css/groups.css">
<script src="/assets/js/booking-pickers.js" defer></script>
</head>
<body class="demo-page">
<div class="demo-shell">
<%- include('partials/navigation', { activePage: 'groups' }) %>
<main>
<header class="listing-header" aria-labelledby="groups-title">
  <div>
    <h1 id="groups-title"><%= title %></h1>
    <p class="listing-description">Chọn buổi chơi hợp lịch, làm quen với bạn mới và cùng chia tiền sân.</p>
  </div>
  <div class="demo-actions">
    <a class="demo-button" href="/groups/new">Rủ bạn cùng chơi</a>
    <a class="demo-button demo-button-secondary" href="/courts">Thuê sân riêng</a>
  </div>
</header>
<%
  const f = typeof filters !== 'undefined' ? filters : { q: '', date: '', openOnly: false, mine: false };
  const hasFilters = Boolean(f.q || f.date || f.openOnly);
  const groupListUrl = mine => {
    const query = new URLSearchParams();
    if (mine) query.set('mine', '1');
    if (f.q) query.set('q', f.q);
    if (f.date) query.set('date', f.date);
    if (f.openOnly) query.set('open', '1');
    return query.size ? '/groups?' + query.toString() : '/groups';
  };
%>
<% if (currentUser) { %>
  <nav class="demo-actions group-scope" aria-label="Danh sách buổi chơi">
    <a class="demo-button<%= f.mine ? ' demo-button-secondary' : '' %>" href="<%= groupListUrl(false) %>" <%- !f.mine ? 'aria-current="page"' : '' %>>Tất cả buổi chơi</a>
    <a class="demo-button<%= f.mine ? '' : ' demo-button-secondary' %>" href="<%= groupListUrl(true) %>" <%- f.mine ? 'aria-current="page"' : '' %>>Buổi tôi tham gia</a>
  </nav>
<% } %>
<form method="GET" action="/groups" class="demo-card group-filters" aria-label="Tìm kiếm buổi chơi">
  <% if (f.mine) { %><input type="hidden" name="mine" value="1"><% } %>
  <input type="search" name="q" value="<%= f.q %>" placeholder="Tìm theo tên buổi, cơ sở, sân…" aria-label="Tên buổi, cơ sở hoặc sân" maxlength="80">
  <%- include('partials/booking-picker-field', { id: 'groups-date', name: 'date', value: f.date, label: 'Lọc theo ngày chơi' }) %>
  <label><input type="checkbox" name="open" value="1" <%= f.openOnly ? 'checked' : '' %>> Chỉ hiện buổi còn chỗ</label>
  <button type="submit" class="demo-button">Lọc</button>
  <% if (hasFilters) { %><a class="demo-button demo-button-secondary" href="<%= f.mine ? '/groups?mine=1' : '/groups' %>">Xóa lọc</a><% } %>
</form>
<section class="group-grid">
<% if (!groups.length) { %>
<article class="demo-card group-empty">
<% if (hasFilters) { %>
  <h2>Không tìm thấy buổi chơi phù hợp</h2>
  <p>Thử đổi ngày, từ khóa hoặc bỏ lọc chỗ trống.</p>
<% } else if (f.mine) { %>
  <h2>Bạn chưa tham gia buổi sân ghép nào</h2>
  <a class="demo-button" href="/groups">Xem tất cả buổi chơi</a>
<% } else { %>
  <h2>Chưa có buổi sân ghép</h2>
  <p>Bạn có thể tạo buổi từ đơn đã xác nhận rồi gửi đường dẫn cho bạn bè.</p>
<% } %>
</article>
<% } %>
<% for (const g of groups) { if (!g.booking) continue; const cancelled = g.booking.status === 'CANCELLED'; const ended = g.booking.slots.every(s => +new Date(s.endAt) <= Date.now()); const closed = g.closedAt || +new Date(g.closesAt) <= Date.now(); %>
<article class="demo-card group-card">
<span class="group-tag">
<%= cancelled ? 'Đã hủy' : ended ? 'Đã kết thúc' : closed ? 'Đã chốt nhóm' : g.members.length >= g.capacity ? 'Đủ người' : 'Đang tìm bạn' %>
</span>
<h2>
<a href="/groups/<%= g._id %>">
<%= g.title %>
</a>
</h2>
<p>
<%= g.booking.facility?.name %> · <%= g.booking.court?.name %>
</p>
<p>
<strong>
<%= formatDate(g.booking.date) %>
</strong> · <%= formatTime(g.booking.slots[0].startAt) %>–<%= formatTime(g.booking.slots[g.booking.slots.length-1].endAt) %>
</p>
<div class="group-meter">
<span style="width:<%= Math.round(g.members.length/g.capacity*100) %>%">
</span>
</div>
<div class="group-price">
<span>
<%= g.members.length %>/<%= g.capacity %> người</span>
<strong>
<%= formatMoney(Math.ceil(g.total/g.members.length)) %>
<small>/người · <%= closed ? 'xấp xỉ' : 'tạm tính' %>
</small>
</strong>
</div>
<a class="demo-button demo-button-secondary" href="/groups/<%= g._id %>">Xem buổi chơi →</a>
</article>
<% } %>
</section>
</main>
</div>

  <%- include('partials/footer') %>
</body>
</html>
