<footer class="site-footer no-print" role="contentinfo">
  <div class="site-footer-inner">
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <a class="site-footer-logo" href="/" aria-label="Sân Thể Thao - Trang chủ">
          <span class="site-footer-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none"><rect x="7" y="5" width="18" height="22" rx="1"/><path d="M7 16h18M16 5v22M7 10h18M7 22h18"/></svg>
          </span>
          <span>Sân Thể Thao<span class="site-footer-dot">.</span></span>
        </a>
        <p class="site-footer-tagline">Đặt sân theo khung 30 phút, giữ chỗ minh bạch và kết nối người chơi cùng lịch tại các cơ sở thể thao.</p>
        <p class="site-footer-meta">Múi giờ hiển thị: Việt Nam (UTC+7)</p>
      </div>

      <div class="site-footer-col">
        <h2>Khám phá</h2>
        <ul>
          <li><a href="/">Trang chủ</a></li>
          <li><a href="/facilities">Danh sách cơ sở</a></li>
          <li><a href="/courts">Thuê sân riêng</a></li>
          <li><a href="/groups">Sân ghép tìm bạn</a></li>
        </ul>
      </div>

      <div class="site-footer-col">
        <h2>Tài khoản</h2>
        <ul>
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <li><a href="/my-bookings">Đơn đặt của tôi</a></li>
            <li><a href="/groups?mine=1">Buổi sân ghép của tôi</a></li>
            <% if (currentUser.role === 'OWNER') { %>
              <li><a href="/owner">Quản lý cơ sở</a></li>
            <% } %>
            <% if (currentUser.role === 'ADMIN') { %>
              <li><a href="/admin">Quản trị hệ thống</a></li>
            <% } %>
          <% } else { %>
            <li><a href="/login">Đăng nhập</a></li>
            <li><a href="/register">Đăng ký khách đặt sân</a></li>
            <li><a href="/register/owner">Đăng ký mở cơ sở / chủ sân</a></li>
            <li><a href="/forgot-password">Quên mật khẩu</a></li>
          <% } %>
        </ul>
      </div>

      <div class="site-footer-col">
        <h2>Quy định đặt sân</h2>
        <ul class="site-footer-rules">
          <li>Giữ chỗ tối đa 10 phút, kết thúc trước giờ bắt đầu ô đầu tiên.</li>
          <li>Yêu cầu hủy hoặc đổi lịch gửi trước giờ chơi tối thiểu 36 giờ.</li>
          <li>Khách vãng lai liên hệ trực tiếp số điện thoại của cơ sở khi cần hỗ trợ.</li>
          <li>Chế độ thanh toán: <strong><%= typeof paymentMode !== 'undefined' && paymentMode === 'demo' ? 'Mô phỏng / Sandbox' : 'Chưa mở trực tuyến' %></strong>.</li>
        </ul>
      </div>
    </div>

    <div class="site-footer-bottom">
      <p>© 2026 Sân Thể Thao. Hẹn nhau ở sân, chơi trọn niềm vui.</p>
      <p class="site-footer-status">Hệ thống quản lý đặt sân thể thao</p>
    </div>
  </div>
</footer>
