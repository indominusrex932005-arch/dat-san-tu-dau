<%
  const _items = Array.isArray(suggestions) ? suggestions.slice(0, 3) : [];
  const _message = typeof suggestionMessage === 'string' && suggestionMessage ? suggestionMessage : null;
%>
<% if (_items.length > 0 || _message) { %>
  <section class="court-suggestion-section" aria-labelledby="court-suggestion-heading">
    <div class="court-suggestion-header">
      <div class="court-suggestion-header-content">
        <span class="court-suggestion-eyebrow" aria-hidden="true">Phương án gợi ý</span>
        <h2 id="court-suggestion-heading" class="court-suggestion-title">Phương án thay thế gần nhất</h2>
        <% if (_message) { %>
          <p class="court-suggestion-message"><%= _message %></p>
        <% } %>
        <p class="court-suggestion-note">
          <svg class="court-suggestion-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M10 6v5M10 14h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Lịch sân có thể thay đổi theo thời gian thực. Hệ thống sẽ kiểm tra lại tính khả dụng khi quý khách tiến hành đặt sân.
        </p>
      </div>
    </div>

    <% if (_items.length > 0) { %>
      <div class="court-suggestion-grid">
        <% for (const item of _items) { %>
          <article class="court-suggestion-card">
            <header class="court-suggestion-card-header">
              <div class="court-suggestion-court-meta">
                <span class="court-suggestion-badge" aria-label="Lý do gợi ý: <%= item.reason %>"><%= item.reason %></span>
                <h3 class="court-suggestion-name"><%= item.courtName %></h3>
              </div>
              <p class="court-suggestion-facility">
                <span class="court-suggestion-facility-label">Cơ sở:</span>
                <strong><%= item.facilityName %></strong>
              </p>
            </header>

            <div class="court-suggestion-body">
              <div class="court-suggestion-info-row">
                <div class="court-suggestion-info-item">
                  <span class="court-suggestion-label">Ngày</span>
                  <span class="court-suggestion-value"><%= formatDate(item.date) %></span>
                </div>
                <div class="court-suggestion-info-item">
                  <span class="court-suggestion-label">Khung giờ</span>
                  <span class="court-suggestion-value court-suggestion-highlight"><%= item.startTime %> – <%= item.endTime %></span>
                </div>
                <div class="court-suggestion-info-item">
                  <span class="court-suggestion-label">Thời lượng</span>
                  <span class="court-suggestion-value"><%= item.totalMinutes %> phút</span>
                </div>
              </div>

              <div class="court-suggestion-price-box">
                <span class="court-suggestion-price-label">Tổng giá phương án</span>
                <span class="court-suggestion-price-value"><%= formatMoney(item.totalPriceVND) %></span>
              </div>
            </div>

            <footer class="court-suggestion-footer">
              <a class="courts-button court-suggestion-action" href="/courts/<%= item.courtId %>?date=<%= encodeURIComponent(item.date) %>" aria-label="Xem lịch sân <%= item.courtName %> ngày <%= formatDate(item.date) %>">
                <span>Xem lịch</span>
                <span aria-hidden="true">→</span>
              </a>
            </footer>
          </article>
        <% } %>
      </div>
    <% } %>
  </section>
<% } %>
