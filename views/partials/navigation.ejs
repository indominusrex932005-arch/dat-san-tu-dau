<header class="demo-nav">
  <a class="demo-brand" href="/" aria-label="Sân Thể Thao - Trang chủ"><span class="demo-brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><rect x="7" y="5" width="18" height="22" rx="1"/><path d="M7 16h18M16 5v22M7 10h18M7 22h18"/></svg></span><span>Sân Thể Thao<span class="demo-brand-dot">.</span></span></a>
  <nav class="demo-nav-links" aria-label="Điều hướng chính">
    <a href="/">Trang chủ</a><a href="/facilities">Cơ sở</a><a href="/courts">Thuê sân riêng</a><a href="/groups">Sân ghép</a>
    <% if (currentUser) { %>
      <a href="/my-bookings">Đơn của tôi</a>
      <% if (currentUser.role === 'OWNER') { %><a href="/owner">Quản lý cơ sở</a><% } %>
      <% if (currentUser.role === 'ADMIN') { %><a href="/admin">Duyệt chủ sân</a><% } %>
      <span class="demo-user"><%= currentUser.fullName %></span>
      <form action="/logout" method="POST" class="demo-inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="demo-button demo-button-secondary">Đăng xuất</button>
      </form>
    <% } else { %>
      <a href="/login">Đăng nhập</a><a href="/register">Đăng ký khách</a><a href="/register/owner">Dành cho chủ sân</a>
    <% } %>
  </nav>
</header>
<% if (typeof publicDemo !== 'undefined' && publicDemo) { %>
  <p class="demo-muted" role="note">Bản demo công khai: chỉ nhập thông tin thử; các giao dịch thanh toán đều là mô phỏng.</p>
<% } %>
