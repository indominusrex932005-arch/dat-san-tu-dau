<!DOCTYPE html>
<html lang="vi"><head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Sân Thể Thao</title>
  <link rel="stylesheet" href="/assets/css/app.css"><link rel="stylesheet" href="/assets/css/demo.css"><link rel="stylesheet" href="/assets/css/booking.css">
</head><body class="demo-page"><div class="demo-shell">
  <%- include('partials/navigation') %>
  <main class="demo-card demo-narrow">
    <h1><%= title %></h1><p class="demo-muted">Khách đặt sân, chủ sân và quản trị viên dùng cùng trang đăng nhập.</p>
    <% if (errorMessage) { %><p class="demo-error" role="alert"><%= errorMessage %></p><% } %>
    <form action="/login" method="POST" class="demo-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="email">Email</label><input type="email" id="email" name="email" value="<%= email %>" autocomplete="username" maxlength="254" required>
      <label for="password">Mật khẩu</label><input type="password" id="password" name="password" autocomplete="current-password" required>
      <button class="demo-button" type="submit">Đăng nhập</button>
    </form>
    <p>Chưa có tài khoản? <a href="/register">Đăng ký khách</a> hoặc <a href="/register/owner">đăng ký chủ sân</a>.</p>
    <p class="demo-muted">Bạn có thể <a href="/courts">tiếp tục đặt sân không cần đăng nhập</a>.</p>
  </main>
</div></body></html>
