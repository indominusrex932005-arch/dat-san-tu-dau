<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | SanXanh</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/demo.css">
  <link rel="stylesheet" href="/assets/css/login.css">
  <link rel="stylesheet" href="/assets/css/design-system.css">
  <link rel="stylesheet" href="/assets/css/groups.css">
  <script src="/assets/js/login.js" defer></script>
  <% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>
</head>
<body class="demo-page login-page">
  <div class="login-shell">
    <%- include('partials/navigation') %>
    <main class="login-main login-main-single" id="forgot-content" tabindex="-1">
      <section class="login-card" aria-labelledby="forgot-title">
        <p class="login-card-eyebrow">Khôi phục tài khoản</p>
        <h1 id="forgot-title"><%= title %></h1>
        <p class="login-card-description">Nhập email tài khoản của bạn. Chúng tôi sẽ gửi đường dẫn đặt lại mật khẩu có hiệu lực trong 15 phút.</p>
        <% if (successMessage) { %>
          <div class="login-success" role="status">
            <p><%= successMessage %></p>
            <% if (typeof devResetUrl !== 'undefined' && devResetUrl) { %>
              <p class="login-dev-hint">Chế độ dev (chưa cấu hình email thật): <a href="<%= devResetUrl %>">Bấm vào đây để đặt lại mật khẩu ngay</a>.</p>
            <% } %>
          </div>
        <% } %>
        <% if (errorMessage) { %>
          <div class="login-error" role="alert">
            <p class="login-error-title">Không thể gửi yêu cầu</p>
            <p><%= errorMessage %></p>
          </div>
        <% } %>
        <form action="/forgot-password" method="POST" class="login-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="login-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= email %>" autocomplete="email" maxlength="254" required>
          </div>
          <%- include('partials/bot-check') %>
          <button type="submit" class="login-submit">Gửi liên kết đặt lại mật khẩu <span aria-hidden="true">↗</span></button>
        </form>
        <p class="login-register"><a href="/login">← Quay lại trang đăng nhập</a></p>
      </section>
    </main>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
