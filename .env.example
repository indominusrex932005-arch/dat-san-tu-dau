# Mẫu cấu hình; không điền hoặc commit bí mật thật vào file này.
MONGODB_URI=
DB_NAME=YOUR_DEDICATED_DEMO_DB
SESSION_SECRET=
NODE_ENV=development
PORT=3000

# Một mode trên server: off mặc định; demo chỉ dùng dữ liệu tổng hợp; live chưa hỗ trợ.
PAYMENT_MODE=off
DEMO_DATA_ONLY=false
# Production demo: PAYMENT_MODE=demo, DEMO_DATA_ONLY=true và DB_NAME tường minh.
# Cam kết này không tự kiểm tra DB; phải dùng DB/tài khoản thử riêng, không dữ liệu thật.
# Xóa hoàn toàn biến cũ DEMO_MODE khỏi môi trường; DEMO_MODE=false vẫn bị từ chối.
