# Mẫu cấu hình; không điền hoặc commit bí mật thật vào file này.
MONGODB_URI=
DB_NAME=YOUR_DEDICATED_DEMO_DB
SESSION_SECRET=
NODE_ENV=development
PORT=3000

# Một mode trên server: off mặc định; demo chỉ dùng dữ liệu tổng hợp; live chưa hỗ trợ.
PAYMENT_MODE=off
DEMO_DATA_ONLY=false
# Production demo: PAYMENT_MODE=demo, DEMO_DATA_ONLY=true và DB_NAME tường minh.
# Cam kết này không tự kiểm tra DB; phải dùng DB/tài khoản thử riêng, không dữ liệu thật.
# Xóa hoàn toàn biến cũ DEMO_MODE khỏi môi trường; DEMO_MODE=false vẫn bị từ chối.

# Mặc định dùng IP kết nối trực tiếp. Chỉ điền IP/CIDR proxy đã được xác minh.
TRUST_PROXY_IPS=

# Số POST tối đa trong mỗi cửa sổ, tính riêng từng route.
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_IP_MAX=60
RATE_LIMIT_LOGIN_ACCOUNT_IP_MAX=8
RATE_LIMIT_REGISTER_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_IP_MAX=12
RATE_LIMIT_REGISTER_OWNER_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_OWNER_IP_MAX=12
RATE_LIMIT_BOOKINGS_WINDOW_SECONDS=600
RATE_LIMIT_BOOKINGS_IP_MAX=60
RATE_LIMIT_BOOKINGS_ACTOR_MAX=12
